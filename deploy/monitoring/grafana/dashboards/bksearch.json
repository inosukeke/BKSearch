{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "BKSearch — Query Service",
  "tags": ["bksearch", "query"],
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "QPS theo path",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (path) (rate(bksearch_http_requests_total[1m]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Độ trễ p95 theo path",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(bksearch_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{path}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, path) (rate(bksearch_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{path}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request đang xử lý (in-flight)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [ { "expr": "bksearch_http_in_flight", "refId": "A" } ]
    },
    {
      "id": 4,
      "title": "Tỉ lệ lỗi (4xx/5xx)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (status) (rate(bksearch_http_requests_total{status=~\"4..|5..\"}[1m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "expr": "bksearch_uptime_seconds", "refId": "A" } ]
    }
  ]
}
