# Sao chép thành .env rồi chỉnh nếu cần:  cp .env.example .env
# (Đây là giá trị DEV chạy local, không dùng cho production.)

POSTGRES_USER=bksearch
POSTGRES_PASSWORD=bksearch_dev
POSTGRES_DB=bksearch

# Bộ nhớ heap cho OpenSearch (giảm còn 512m nếu máy yếu RAM)
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# ---- Embedding + rerank service (Phase 2, S2.1/S2.2/S2.5) ----
# Model bi-encoder tiếng Việt (sinh vector 768 chiều, khớp mapping documents.embedding).
EMBED_MODEL=bkai-foundation-models/vietnamese-bi-encoder
EMBED_DIMS=768
EMBED_BATCH=32
# Cross-encoder rerank (query-side, S2.5).
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# EMBED_FAKE=1 → chạy KHÔNG tải model (smoke/dev nhanh; vector & điểm là giả). Để 0 cho model thật.
EMBED_FAKE=0

# ---- Dùng cho app Java (chạy NGOÀI compose: migrate --embed / serve-api / eval-run --embed) ----
# URL tới embedding service ở trên. Bỏ trống/không đặt → tắt vector/hybrid/rerank.
EMBED_URL=http://localhost:8000
# Số ứng viên đưa vào cross-encoder rerank mỗi truy vấn (S2.5).
RERANK_TOP_K=50
